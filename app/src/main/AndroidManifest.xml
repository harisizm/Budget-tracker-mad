<?xml version="1.0" encoding="utf-8"?>
<!-- Every screen (Activity) must be declared here before Android can open it. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.BudgetTracker">

        <!-- The intent-filter below marks Splash as the screen that opens from the launcher. -->
        <activity
            android:name=".SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- exported=false: only our own app can open these screens -->
        <activity
            android:name=".HomeActivity"
            android:exported="false" />

        <!-- parentActivityName lets the system Back/Up gesture return to Home -->
        <activity
            android:name=".AddTransactionActivity"
            android:exported="false"
            android:parentActivityName=".HomeActivity" />
    </application>

</manifest>
